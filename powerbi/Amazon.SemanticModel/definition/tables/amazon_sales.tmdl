table amazon_sales

	column Tarix
		dataType: dateTime
		formatString: dd.MM.yyyy
		summarizeBy: none
		sourceColumn: Tarix

	column 'Şəhər_İD'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Şəhər_İD

	column 'Sifaris_İD'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Sifaris_İD

	column 'Satış'
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: Satış

	column Tip
		dataType: string
		summarizeBy: none
		sourceColumn: Tip

	column 'Məhsul_kodu'
		dataType: string
		summarizeBy: none
		sourceColumn: Məhsul_kodu

	measure 'Ümumi Satış' = SUM(amazon_sales[Satış])
		formatString: #,0.00

	measure 'Ötən ilin eyni dövrü üzrə satış' = VAR y = YEAR(CALCULATE(MAX(amazon_sales[Tarix]))) RETURN CALCULATE([Ümumi Satış], SAMEPERIODLASTYEAR(FILTER(VALUES('Calendar'[Date]), YEAR('Calendar'[Date]) = y)), REMOVEFILTERS('Calendar'))
		formatString: #,0.00

	measure 'Ötən aya görə satış' = VAR d = CALCULATE(MAX(amazon_sales[Tarix])) RETURN CALCULATE([Ümumi Satış], DATESBETWEEN('Calendar'[Date], EOMONTH(d, -2) + 1, EOMONTH(d, -1)), REMOVEFILTERS('Calendar'))
		formatString: #,0.00

	measure 'Ötən aya görə satışın artım %' = DIVIDE([Cari ay satışı] - [Ötən aya görə satış], [Ötən aya görə satış])
		formatString: 0.0%

	measure 'Satışın ildən ilə böyümə %' = DIVIDE([Cari il satışı] - [Ötən ilin eyni dövrü üzrə satış], [Ötən ilin eyni dövrü üzrə satış])
		formatString: 0.0%

	measure 'Məhsul sayı (növ)' = DISTINCTCOUNT(amazon_sales[Məhsul_kodu])
		formatString: #,0

	measure 'Əməliyyat sayı' = COUNTROWS(amazon_sales)
		formatString: #,0

	measure 'Orta əməliyyat dəyəri' = DIVIDE([Ümumi Satış], [Əməliyyat sayı])
		formatString: #,0.00

	measure 'İlin əvvəlindən satış (YTD)' = TOTALYTD([Ümumi Satış], 'Calendar'[Date])
		formatString: #,0.00

	measure 'Satış payı %' = DIVIDE([Ümumi Satış], CALCULATE([Ümumi Satış], ALLSELECTED()))
		formatString: 0.0%

	measure 'Cari il satışı' = VAR y = YEAR(CALCULATE(MAX(amazon_sales[Tarix]))) RETURN CALCULATE([Ümumi Satış], FILTER(VALUES('Calendar'[Date]), YEAR('Calendar'[Date]) = y))
		formatString: #,0.00

	measure 'Cari ay satışı' = VAR d = CALCULATE(MAX(amazon_sales[Tarix])) RETURN CALCULATE([Ümumi Satış], DATESBETWEEN('Calendar'[Date], EOMONTH(d, -1) + 1, EOMONTH(d, 0)), REMOVEFILTERS('Calendar'))
		formatString: #,0.00

	partition amazon_sales = m
		mode: import
		source =
				let
				    Src = Csv.Document(File.Contents(FolderPath & "sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Hdr = Table.PromoteHeaders(Src, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Hdr, {{"Seher_ID", "Şəhər_İD"}, {"Sifaris_ID", "Sifaris_İD"}, {"Satis", "Satış"}, {"Mehsul_kodu", "Məhsul_kodu"}}),
				    Result = Table.TransformColumnTypes(Renamed, {{"Tarix", type date}, {"Şəhər_İD", Int64.Type}, {"Sifaris_İD", Int64.Type}, {"Satış", type number}, {"Tip", type text}, {"Məhsul_kodu", type text}}, "en-US")
				in
				    Result
